# URL pública para Socket.io (tunnel o dominio de producción)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Link del botón Sponsor en la topbar
NEXT_PUBLIC_SPONSOR_URL=https://ko-fi.com/lucasmella

# Puerto del servidor
PORT=3000

# (Opcional) Token de ngrok para el tunnel de desarrollo — pnpm tunnel
# Obtener en: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# ── Tracking ────────────────────────────────────────────────────────────────
# Errores: Sentry SDK → GlitchTip (errors.hausdersieg.com). UN solo nombre.
# Servidor/edge lo leen en runtime; el cliente lo necesita en BUILD
# (docker build --build-arg GLITCHTIP_DSN=...). Vacío = SDK desactivado.
# OJO: la public key va en hex SIN guiones (el SDK rechaza el UUID con guiones
# con un solo "Invalid Sentry Dsn" en consola y no envía nada).
# Formato: https://<key-hex-32>@errors.hausdersieg.com/4
GLITCHTIP_DSN=
# Etiqueta environment del evento (default: production)
GLITCHTIP_ENVIRONMENT=development
